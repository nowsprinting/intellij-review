<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.nowsprinting.intellij-review</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Re:VIEW</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/nowsprinting">Koji Hasegawa</vendor>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <!-- YAMLプラグインを無効化したIDEでも.re側の機能は使えるよう、必須依存にはしない -->
    <depends optional="true" config-file="review-yaml.xml">org.jetbrains.plugins.yaml</depends>

    <resource-bundle>messages.ReviewBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="Re:VIEW" implementationClass="com.nowsprinting.intellijreview.lang.ReviewFileType"
                   fieldName="INSTANCE" language="ReVIEW" extensions="re"/>
        <lang.parserDefinition language="ReVIEW"
                               implementationClass="com.nowsprinting.intellijreview.parser.ReviewParserDefinition"/>
        <lang.syntaxHighlighterFactory language="ReVIEW"
                                       implementationClass="com.nowsprinting.intellijreview.highlighter.ReviewSyntaxHighlighterFactory"/>
        <colorSettingsPage implementation="com.nowsprinting.intellijreview.highlighter.ReviewColorSettingsPage"/>
        <lang.commenter language="ReVIEW"
                         implementationClass="com.nowsprinting.intellijreview.highlighter.ReviewCommenter"/>
        <completion.contributor language="ReVIEW"
                                 implementationClass="com.nowsprinting.intellijreview.completion.ReviewCompletionContributor"/>
        <lang.elementManipulator forClass="com.nowsprinting.intellijreview.psi.impl.ReviewBlockCommandMixin"
                                  implementationClass="com.nowsprinting.intellijreview.rename.ReviewBlockArgManipulator"/>
        <lang.elementManipulator forClass="com.nowsprinting.intellijreview.psi.impl.ReviewInlineCommandMixin"
                                  implementationClass="com.nowsprinting.intellijreview.rename.ReviewInlineCommandManipulator"/>
        <lang.findUsagesProvider language="ReVIEW"
                                  implementationClass="com.nowsprinting.intellijreview.usages.ReviewFindUsagesProvider"/>
        <lang.refactoringSupport language="ReVIEW"
                                  implementationClass="com.nowsprinting.intellijreview.rename.ReviewRefactoringSupportProvider"/>
        <lang.psiStructureViewFactory language="ReVIEW"
                                       implementationClass="com.nowsprinting.intellijreview.structure.ReviewStructureViewFactory"/>
        <enterHandlerDelegate implementation="com.nowsprinting.intellijreview.editor.ReviewContinuationEnterHandler"/>
        <typedHandler implementation="com.nowsprinting.intellijreview.completion.ReviewPipeTypedHandler"/>
        <annotator language="ReVIEW" implementationClass="com.nowsprinting.intellijreview.annotator.ReviewAnnotator"/>
        <fileEditorProvider implementation="com.nowsprinting.intellijreview.preview.ReviewSplitEditorProvider"/>
    </extensions>

</idea-plugin>
